{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run check *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run lint:fix *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run doctor *)",
      "Bash(npm run screenshot *)",
      "Bash(npm run e2e *)",
      "Bash(npm run sync-base *)",
      "Bash(npx expo install *)",
      "Bash(npx expo config *)",
      "Bash(npx expo export *)",
      "Bash(npx expo lint *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl io booted screenshot *)",
      "Bash(adb devices *)",
      "Bash(adb logcat *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(npm run release *)",
      "Bash(npm run deploy *)",
      "Bash(npm run update:production *)",
      "Bash(npm run build:production *)",
      "Bash(npx eas-cli@latest submit *)",
      "Bash(npx eas-cli@latest update *)",
      "Bash(npx eas-cli@latest workflow:run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
